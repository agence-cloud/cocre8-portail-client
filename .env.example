# Les variables de l'app. Copier en .env.local et remplir avec les valeurs du
# projet Supabase. Ce fichier-ci ne contient aucune valeur, il ne dit que les
# noms : c'est le seul des deux qui est versionné.

# --- Nécessaires en production, à poser aussi sur l'hébergeur --------------

# Tableau de bord Supabase, Project Settings, Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clé de service. Elle contourne toutes les permissions par ligne.
#
# Un seul fichier de l'app la lit, lib/supabase/service.ts, et trois s'en
# servent : lib/auth/installation.ts pour créer le premier compte sur une base
# vierge, lib/auth/creation.ts pour créer le compte d'un client, et
# lib/auth/apercu.ts pour ouvrir l'espace d'un client sous son identité. La
# liste se vérifie par `grep -rn "supabase/service" lib modules app`, jamais
# par une liste écrite qu'il faudrait croire.
#
# Ne jamais la préfixer de NEXT_PUBLIC_, ce préfixe l'enverrait dans le
# navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Nécessaires en local seulement ---------------------------------------

# Les comptes que les tests de parcours utilisent. Ils se connectent pour de
# vrai, sur la base que tu leur donnes : ne les fais jamais pointer sur une
# base qui porte de vrais clients.
TEST_ADMIN_EMAIL=
TEST_ADMIN_MOTDEPASSE=
TEST_MEMBRE_EMAIL=
TEST_MEMBRE_MOTDEPASSE=
